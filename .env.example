# Aider web app configuration. Every variable is optional.
# Copy to .env.local and edit. NEXT_PUBLIC_* values are inlined into the browser bundle at build time.

# Visitors switch between Arc Testnet and Arc mainnet with the switch in the top bar.
# This is the network they see first: testnet (default) or mainnet.
NEXT_PUBLIC_AIDER_NETWORK=testnet

# Arc Testnet (chain 5042002). The contract defaults to the public deployment
# 0xed32e15d81e7864bf19caea4333bd0781f328ba3 (deploy block 69187895).
NEXT_PUBLIC_AIDER_TESTNET_CONTRACT=
NEXT_PUBLIC_AIDER_TESTNET_DEPLOY_BLOCK=
NEXT_PUBLIC_AIDER_TESTNET_RPC_URL=

# Arc mainnet (chain 5042). No default contract: until you set one, mainnet shows
# "Aider isn't on Arc mainnet yet". Set the deploy block too, or the activity
# indexer scans from block 0 (slow). A dedicated RPC is recommended.
NEXT_PUBLIC_AIDER_MAINNET_CONTRACT=
NEXT_PUBLIC_AIDER_MAINNET_DEPLOY_BLOCK=
NEXT_PUBLIC_AIDER_MAINNET_RPC_URL=

# Older single-network names, still read for the default network:
# NEXT_PUBLIC_AIDER_CONTRACT, NEXT_PUBLIC_AIDER_DEPLOY_BLOCK, NEXT_PUBLIC_AIDER_RPC_URL

# Links shown in the nav, docs and footer.
NEXT_PUBLIC_AIDER_GITHUB_URL=https://github.com/bigjoe-io/aider
# Optional; the X icon is hidden when unset.
NEXT_PUBLIC_AIDER_X_URL=

# QA only: in `next dev` (never in production builds), set to 1 to add wagmi's mock
# connector for the address below, so tests can drive the UI against a local chain.
NEXT_PUBLIC_AIDER_E2E=
NEXT_PUBLIC_AIDER_E2E_ACCOUNT=
