# Aider web app configuration. Every variable is optional.
# Copy to .env.local and edit. NEXT_PUBLIC_* values are inlined into the browser bundle at build time.

# Network: testnet (Arc Testnet, chain 5042002, default) or mainnet (Arc, chain 5042)
NEXT_PUBLIC_AIDER_NETWORK=testnet

# Aider contract address. Defaults to the public testnet deployment
# 0xed32e15d81e7864bf19caea4333bd0781f328ba3 on testnet; no default on mainnet
# (the app shows a "not deployed on this network yet" state until you set it).
NEXT_PUBLIC_AIDER_CONTRACT=

# Block the contract was deployed in (the activity indexer starts scanning here).
# Defaults to 69187895 for the default testnet contract, otherwise 0 (slow).
NEXT_PUBLIC_AIDER_DEPLOY_BLOCK=

# Optional JSON-RPC URL override for the Aider chain (e.g. a private RPC or a local anvil).
NEXT_PUBLIC_AIDER_RPC_URL=

# Links shown in the nav, docs and footer.
NEXT_PUBLIC_AIDER_GITHUB_URL=https://github.com/bigjoe-io/aider
# Optional; the X icon is hidden when unset.
NEXT_PUBLIC_AIDER_X_URL=

# QA only: in `next dev` (never in production builds), set to 1 to add wagmi's mock
# connector for the address below, so tests can drive the UI against a local chain.
NEXT_PUBLIC_AIDER_E2E=
NEXT_PUBLIC_AIDER_E2E_ACCOUNT=
